# LangSmith tracing (Agent Server traces every run when these are set)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=durable-orchestrator-demo
# Required for org-scoped service keys (lsv2_sk_...); without it trace writes fail with 403 Forbidden.
# Find it in LangSmith under Settings -> Workspaces.
LANGSMITH_WORKSPACE_ID=

# Optional: real LLM sub-agents / planner. Unset = deterministic scripted sub-agents (no keys needed).
# SUBAGENT_MODEL=anthropic:claude-haiku-4-5
# PLANNER_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Notebook / scripts targets (default: local dev server on :2024)
# LANGGRAPH_URL=https://<orchestrator-deployment>.us.langgraph.app
# OPERATOR_URL=https://<upgrade-operator-deployment>.us.langgraph.app

# Scale the mock tools' simulated latency (1 = default demo pacing)
MOCK_LATENCY_SCALE=1
