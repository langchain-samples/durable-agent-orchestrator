# Copy to .env. `mda` forwards non-reserved values to the deployment as secrets.

# LangSmith API key: required for `mda dev` / `mda deploy`
LANGSMITH_API_KEY=
# Required only for org-scoped service keys (lsv2_sk_...)
# LANGSMITH_WORKSPACE_ID=

# Durable orchestrator this agent operates (local dev server or the hosted orchestrator URL)
ORCHESTRATOR_URL=http://127.0.0.1:2024
# Sent as X-Tenant-Id to a hosted orchestrator when the key is org-scoped
# ORCHESTRATOR_WORKSPACE_ID=

# The hosted orchestrator's API key is NOT set here. Store it as an agent-owned connection:
#   uv run mda connections create orchestrator-api --secret-from-env <ENV_VAR_HOLDING_THE_KEY>
